{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenJar Desktop",
  "version": "1.0.1",
  "identifier": "com.farukes.tokenjar",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../../frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../../frontend",
    "frontendDist": "../../src/tokenjar/ui/static"
  },
  "app": {
    "windows": [
      {
        "title": "TokenJar | Intelligent Token Optimization Engine",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
